# Supabase project reference and API URL
SUPABASE_PROJECT_ID=your-supabase-project-ref
SUPABASE_URL=https://your-supabase-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Public browser variables (safe to expose; must be the publishable key)
VITE_SUPABASE_PROJECT_ID=your-supabase-project-ref
VITE_SUPABASE_URL=https://your-supabase-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Optional public base URL for generated survey links after connecting a custom domain in Lovable.
# Do not set this to the Lovable preview URL if you want branded production links.
# VITE_PUBLIC_SURVEY_BASE_URL=https://pesquisas.seudominio.com.br

# Server-only AI provider for recovery briefings (never use VITE_ prefix).
# Configure the real secret in Lovable Cloud / server secrets, not in browser code.
# OPENAI_API_KEY=replace_with_server_only_secret
# Optional model override; default: gpt-6-luna
# OPENAI_MODEL=gpt-6-luna

# Optional server-only admin client. Never prefix this with VITE_ or expose it to the browser.
# Configure this secret only in the server runtime / Lovable Cloud secrets.
# SUPABASE_SERVICE_ROLE_KEY=replace_with_server_only_secret
